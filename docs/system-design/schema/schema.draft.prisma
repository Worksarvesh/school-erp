// DRAFT V1.1 schema (Phase B design, 2026-11-07). NOT the live schema: apps/api/prisma/schema.prisma is.
// Nothing here is migrated. Each build slice copies the models it needs into the live schema.
//
// Conventions (see README.md):
// - UUIDv7 ids generated by Prisma (uuid(7)); snake_case in the database, camelCase in code.
// - Every school-owned table has school_id NOT NULL and RLS (policies live in hand-written SQL, see RLS-MATRIX.md).
// - Every table that other school tables point at has @@unique([schoolId, id]); children point at it with a
//   COMPOSITE foreign key (school_id, x_id). Foreign-key checks ignore RLS, so this is what stops a row in
//   school A from referencing a row in school B.
// - "Root" school tables carry a direct relation to School; child tables reach the school through their parent.
// - Actor columns (created_by, marked_by, decided_by, ...) are plain user ids without a foreign key, as today.
// - Partitioned tables (student_attendance, notifications, audit_logs) have the partition key in the primary key;
//   partitions themselves are created in hand-written SQL.
// - Removed from V1.1 on purpose: messaging, notification preferences, fees, admissions, discipline,
//   IT staff/tickets/devices, transport, biometric, student documents, timetable rooms and breaks.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

