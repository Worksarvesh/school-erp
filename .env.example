# Copy to `.env` (never commit `.env`). Every value below is a placeholder.
# Use separate values for development, staging and production.

NODE_ENV=development
APP_ENV=development            # development | staging | production

# Local Docker PostgreSQL (docker-compose.yml). Pick your own local-only passwords.
DB_SUPERUSER_PASSWORD=<local-only-password>
DB_OWNER_PASSWORD=<local-only-password>
DB_APP_PASSWORD=<local-only-password>

# API (apps/api)
API_PORT=3000
# App role: no BYPASSRLS, not the table owner. Used by the running API.
DATABASE_URL=postgresql://school_erp_app:<DB_APP_PASSWORD>@localhost:5434/school_erp
# Owner role: runs migrations only. Never used by the running API.
MIGRATION_DATABASE_URL=postgresql://school_erp_owner:<DB_OWNER_PASSWORD>@localhost:5434/school_erp
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>

# Never put a database service-role key or any privileged secret in web/mobile env files.
# Only public, non-sensitive values may be exposed to clients.
