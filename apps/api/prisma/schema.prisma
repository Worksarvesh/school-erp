// Tenancy core (build order Step 1). RLS policies live in the SQL migrations, not here.
// Conventions: UUIDv7 ids generated by Prisma, snake_case in the database, camelCase in code.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  principal
  school_admin
  vice_principal
  teacher
  non_teaching_staff
  office_clerk
  accountant
  student
  parent
  other_staff

  @@map("role")
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked

  @@map("membership_status")
}

enum SchoolStatus {
  active
  suspended

  @@map("school_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// A school is the tenant. RLS: visible when it is the current app.school_id, or (read-only)
/// when app.user_id has an active membership in it.
model School {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  code      String       @unique
  udiseCode String?      @unique @map("udise_code")
  status    SchoolStatus @default(active)
  shardKey  Int          @default(0) @map("shard_key") @db.SmallInt
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  memberships SchoolMembership[]

  @@map("schools")
}

/// Global person (one account, possibly in several schools). Owned by the users module.
/// RLS: visible when it is app.user_id, or when the user is a member of app.school_id.
/// phone (E.164) and email (lower case) are stored normalised, in plain text: a deliberate
/// deviation from "encrypt sensitive columns", to revisit in the DPDP review.
model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  fullName  String     @map("full_name")
  phone     String?    @unique
  email     String?    @unique
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  memberships SchoolMembership[]
  credential  Credential?
  sessions    Session[]

  @@map("users")
}

/// Password hash (argon2id). Owned by the auth module. RLS: only the user's own row (app.user_id).
model Credential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @map("password_changed_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("credentials")
}

/// One signed-in device. Owned by the auth module. RLS: only the user's own rows (app.user_id).
/// The refresh token is `<id>.<secret>`; only SHA-256 hashes of secrets are stored. Each refresh
/// moves token_hash to previous_token_hash; presenting the previous token again is reuse.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  previousTokenHash String?   @map("previous_token_hash")
  deviceName        String?   @map("device_name")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revokedReason     String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Append-only security log. Owned by the audit module. school_id is null for global events
/// (login). RLS: a school context reads its own rows; the app role may insert, never update/delete.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  ip          String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Grants a user one role in one school. A user may hold several roles in the same school.
/// RLS: rows of app.school_id; plus read-only access to the user's own rows via app.user_id.
model SchoolMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(invited)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?          @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, schoolId, role])
  @@index([schoolId])
  @@map("school_memberships")
}

/// Global permission catalogue. Read-only for the app role.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

/// Default role -> permission mapping (global). Per-school overrides come later.
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         Role
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}
