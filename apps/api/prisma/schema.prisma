// Tenancy core (build order Step 1). RLS policies live in the SQL migrations, not here.
// Conventions: UUIDv7 ids generated by Prisma, snake_case in the database, camelCase in code.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  principal
  school_admin
  vice_principal
  teacher
  non_teaching_staff
  office_clerk
  accountant
  student
  parent
  other_staff

  @@map("role")
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked

  @@map("membership_status")
}

enum SchoolStatus {
  active
  suspended

  @@map("school_status")
}

/// A school is the tenant. RLS: visible only when it is the current app.school_id.
model School {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  code      String       @unique
  udiseCode String?      @unique @map("udise_code")
  status    SchoolStatus @default(active)
  shardKey  Int          @default(0) @map("shard_key") @db.SmallInt
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  memberships SchoolMembership[]

  @@map("schools")
}

/// Global person (one account, possibly in several schools). Login fields arrive in Step 2.
/// RLS: visible when it is app.user_id, or when the user is a member of app.school_id.
model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships SchoolMembership[]

  @@map("users")
}

/// Grants a user one role in one school. A user may hold several roles in the same school.
/// RLS: rows of app.school_id; plus read-only access to the user's own rows via app.user_id.
model SchoolMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(invited)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?          @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, schoolId, role])
  @@index([schoolId])
  @@map("school_memberships")
}

/// Global permission catalogue. Read-only for the app role.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

/// Default role -> permission mapping (global). Per-school overrides come later.
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         Role
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}
