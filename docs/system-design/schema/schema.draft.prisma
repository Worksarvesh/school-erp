// ============================================================================================
// Tenancy and identity
// ============================================================================================

/// The tenant. code is sch + 4+ digits from the global sequence school_code_seq (CHECK code ~ '^sch[0-9]{4,}$').
/// Branding (name, logo, address, contact) is managed by the Principal and shown in the Student App.
model School {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  code         String       @unique
  udiseCode    String?      @unique @map("udise_code")
  status       SchoolStatus @default(active)
  shardKey     Int          @default(0) @map("shard_key") @db.SmallInt
  addressLine  String?      @map("address_line")
  city         String?
  state        String?
  pinCode      String?      @map("pin_code")
  contactPhone String?      @map("contact_phone")
  contactEmail String?      @map("contact_email")
  logoFileId   String?      @map("logo_file_id") @db.Uuid
  timezone     String       @default("Asia/Kolkata")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.Uuid
  updatedBy    String?      @map("updated_by") @db.Uuid

  memberships          SchoolMembership[]
  usernameSequences    UsernameSequence[]
  verificationRequests SchoolVerificationRequest[]
  credentialIssuances  CredentialIssuance[]
  academicYears        AcademicYear[]
  classes              Class[]
  subjects             Subject[]
  students             Student[]
  studentFieldDefs     StudentFieldDefinition[]
  departments          Department[]
  staff                Staff[]
  leaveTypes           LeaveType[]
  approvalRequests     ApprovalRequest[]
  notices              Notice[]
  calendarEvents       CalendarEvent[]
  notifications        Notification[]
  inventoryItems       InventoryItem[]
  maintenanceRequests  MaintenanceRequest[]
  importJobs           ImportJob[]
  files                File[]
  assets               Asset[]

  @@map("schools")
}

/// Global person. username is set for school-issued accounts (staff, students) and is unique system-wide;
/// a username account belongs to the school that issued it. phone is set for OTP accounts (principal, parent).
/// CHECK: username IS NOT NULL OR phone IS NOT NULL.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  fullName        String     @map("full_name")
  username        String?    @unique
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  email           String?    @unique
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  memberships   SchoolMembership[]
  credential    Credential?
  sessions      Session[]
  pushTokens    PushToken[]
  platformStaff PlatformStaff?
  parentLinks   ParentStudentLink[]
  student       Student?
  staff         Staff[]
  verifications SchoolVerificationRequest[]
  notifications Notification[]

  @@map("users")
}

/// One password hash per user (argon2id). A temporary password (6 characters, shown once) is stored here with
/// must_change_password = true; there is never a second copy of any hash.
model Credential {
  userId             String   @id @map("user_id") @db.Uuid
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime @map("password_changed_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("credentials")
}

/// History of issued temporary passwords (initial and admin-initiated resets). Metadata only, no hash.
model CredentialIssuance {
  id         String                 @id @default(uuid(7)) @db.Uuid
  schoolId   String?                @map("school_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  kind       CredentialIssuanceKind
  issuedBy   String                 @map("issued_by") @db.Uuid
  issuedAt   DateTime               @default(now()) @map("issued_at") @db.Timestamptz
  shownAt    DateTime?              @map("shown_at") @db.Timestamptz
  consumedAt DateTime?              @map("consumed_at") @db.Timestamptz
  expiresAt  DateTime               @map("expires_at") @db.Timestamptz
  reason     String?

  school School? @relation(fields: [schoolId], references: [id])

  @@index([userId, issuedAt])
  @@index([schoolId, issuedAt])
  @@map("credential_issuances")
}

/// Next number per school and kind. Allocated with UPDATE ... SET next_value = next_value + 1 RETURNING,
/// which row-locks, so two Admins never get the same username.
model UsernameSequence {
  schoolId  String       @map("school_id") @db.Uuid
  kind      UsernameKind
  nextValue Int          @default(1) @map("next_value")
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, kind])
  @@map("username_sequences")
}

model Session {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash")
  previousTokenHash String?    @map("previous_token_hash")
  deviceName        String?    @map("device_name")
  clientApp         ClientApp? @map("client_app")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt        DateTime   @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz
  revokedReason     String?    @map("revoked_reason")

  user       User        @relation(fields: [userId], references: [id])
  pushTokens PushToken[]

  @@index([userId])
  @@map("sessions")
}

/// Push token of one app install. app decides which app a notification goes to (a parent's Student App, not
/// the same person's School App). Revoked with its session.
model PushToken {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  sessionId  String?        @map("session_id") @db.Uuid
  app        ClientApp
  platform   DevicePlatform
  token      String         @unique
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([userId, app])
  @@map("push_tokens")
}

/// OTP for Principal and Parent. Reached only through SECURITY DEFINER functions (create/verify), never by the
/// app role directly. code_hash only; codes never stored or logged. 6 digits, 5 min, 5 attempts (design §4).
/// Until real SMS exists, OTP_PROVIDER=fixed creates normal challenges whose expected code is OTP_FIXED_CODE
/// (999999): same rows, expiry, attempts and rate limits. Switching to OTP_PROVIDER=sms changes no tables.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  purpose     OtpPurpose
  phone       String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0) @db.SmallInt
  maxAttempts Int        @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

/// New principal registration. Either school_id (picked from the directory) or the "not listed" fields.
/// CHECK: (school_id IS NOT NULL) <> (proposed_name IS NOT NULL); status = rejected requires decision_reason.
/// Resubmission creates a new row pointing at the old one.
model SchoolVerificationRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  principalUserId   String             @map("principal_user_id") @db.Uuid
  schoolId          String?            @map("school_id") @db.Uuid
  proposedName      String?            @map("proposed_name")
  proposedAddress   String?            @map("proposed_address")
  proposedPinCode   String?            @map("proposed_pin_code")
  principalName     String             @map("principal_name")
  status            VerificationStatus @default(pending)
  decidedByStaffId  String?            @map("decided_by_staff_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz
  decisionReason    String?            @map("decision_reason")
  previousRequestId String?            @unique @map("previous_request_id") @db.Uuid
  submittedAt       DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  principal       User                       @relation(fields: [principalUserId], references: [id])
  school          School?                    @relation(fields: [schoolId], references: [id])
  previousRequest SchoolVerificationRequest? @relation("VerificationResubmission", fields: [previousRequestId], references: [id])
  nextRequest     SchoolVerificationRequest? @relation("VerificationResubmission")

  @@index([status, submittedAt])
  @@index([principalUserId])
  @@map("school_verification_requests")
}

/// Company staff (Super Admin, School Verifier). Not school members. Separate routes; every access audited.
model PlatformStaff {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole
  status    UserStatus   @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("platform_staff")
}

/// One role for one user in one school (several roles per person allowed; role switching = choosing one).
/// CHECK role <> 'parent'. A teacher's membership is invited until TEACHER_ADDITION is approved.
model SchoolMembership {
  id         String           @id @default(uuid(7)) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       Role
  status     MembershipStatus @default(invited)
  approvedBy String?          @map("approved_by") @db.Uuid
  approvedAt DateTime?        @map("approved_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?          @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, schoolId, role])
  @@index([schoolId, role, status])
  @@map("school_memberships")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         Role
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ============================================================================================
// Academic setup
// ============================================================================================

/// Partial unique index: one active year per school (WHERE status = 'active').
model AcademicYear {
  id        String             @id @default(uuid(7)) @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  name      String
  startsOn  DateTime           @map("starts_on") @db.Date
  endsOn    DateTime           @map("ends_on") @db.Date
  status    AcademicYearStatus @default(planned)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?            @map("created_by") @db.Uuid

  school      School              @relation(fields: [schoolId], references: [id])
  timing      SchoolTiming?
  sections    Section[]
  enrollments StudentEnrollment[]
  assignments TeacherAssignment[]
  timetables  Timetable[]
  exams       Exam[]
  homework    Homework[]
  documents   Document[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("academic_years")
}

/// Working days and timings per academic year. Period n runs from day_start + (n-1) * period_minutes.
/// No breaks, no rooms. CHECK day_start + period_count * period_minutes <= day_end.
model SchoolTiming {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  workingDays    Int[]    @map("working_days") @db.SmallInt
  dayStart       DateTime @map("day_start") @db.Time(0)
  dayEnd         DateTime @map("day_end") @db.Time(0)
  periodMinutes  Int      @map("period_minutes") @db.SmallInt
  periodCount    Int      @map("period_count") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id])

  @@unique([schoolId, academicYearId])
  @@map("school_timings")
}

/// Classes 1 to 12 (CHECK grade BETWEEN 1 AND 12). School-wide, not per year.
model Class {
  id           String       @id @default(uuid(7)) @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  name         String
  grade        Int          @db.SmallInt
  displayOrder Int          @default(0) @map("display_order") @db.SmallInt
  status       RecordStatus @default(active)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.Uuid

  school          School           @relation(fields: [schoolId], references: [id])
  sections        Section[]
  subjects        ClassSubject[]
  examSubjects    ExamSubject[]
  resultSets      ResultSet[]
  noticeAudiences NoticeAudience[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("classes")
}

/// A section of a class in one academic year (sections change every year).
model Section {
  id             String       @id @default(uuid(7)) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  name           String
  capacity       Int?         @db.SmallInt
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid

  academicYear    AcademicYear         @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  class           Class                @relation(fields: [schoolId, classId], references: [schoolId, id])
  enrollments     StudentEnrollment[]
  assignments     TeacherAssignment[]
  registers       AttendanceRegister[]
  attendance      StudentAttendance[]
  timetables      Timetable[]
  substitutions   Substitution[]
  homework        Homework[]
  lessonPlans     LessonPlan[]
  noticeAudiences NoticeAudience[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, classId, name])
  @@map("sections")
}

model Subject {
  id        String       @id @default(uuid(7)) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  name      String
  code      String
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  school           School                        @relation(fields: [schoolId], references: [id])
  classes          ClassSubject[]
  qualifications   TeacherSubjectQualification[]
  assignments      TeacherAssignment[]
  timetableEntries TimetableEntry[]
  examSubjects     ExamSubject[]
  homework         Homework[]
  lessonPlans      LessonPlan[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  class   Class   @relation(fields: [schoolId, classId], references: [schoolId, id])
  subject Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id])

  @@unique([schoolId, classId, subjectId])
  @@map("class_subjects")
}

// ============================================================================================
// People
// ============================================================================================

/// One student in one school (Indian model). Login account = user_id (username sch0001s0001).
/// Added by Admin only after offline management approval: CHECK management_approval_confirmed = true.
/// Optional health fields and hobbies never block app use.
model Student {
  id                          String        @id @default(uuid(7)) @db.Uuid
  schoolId                    String        @map("school_id") @db.Uuid
  userId                      String        @unique @map("user_id") @db.Uuid
  fullName                    String        @map("full_name")
  admissionNumber             String?       @map("admission_number")
  dateOfBirth                 DateTime?     @map("date_of_birth") @db.Date
  gender                      Gender?
  status                      StudentStatus @default(active)
  studentMobile               String?       @map("student_mobile")
  email                       String?
  address                     String?
  emergencyContactName        String?       @map("emergency_contact_name")
  emergencyContactPhone       String?       @map("emergency_contact_phone")
  heightCm                    Int?          @map("height_cm") @db.SmallInt
  weightKg                    Int?          @map("weight_kg") @db.SmallInt
  bloodGroup                  BloodGroup?   @map("blood_group")
  hobbies                     String?
  customFields                Json          @default("{}") @map("custom_fields")
  profileCompletedAt          DateTime?     @map("profile_completed_at") @db.Timestamptz
  managementApprovalConfirmed Boolean       @map("management_approval_confirmed")
  confirmedByUserId           String        @map("confirmed_by_user_id") @db.Uuid
  confirmedAt                 DateTime      @map("confirmed_at") @db.Timestamptz
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  createdBy                   String?       @map("created_by") @db.Uuid
  updatedBy                   String?       @map("updated_by") @db.Uuid

  school                School                 @relation(fields: [schoolId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  enrollments           StudentEnrollment[]
  guardians             StudentGuardian[]
  parentLinks           ParentStudentLink[]
  attendance            StudentAttendance[]
  attendanceCorrections AttendanceCorrection[]
  marks                 MarksEntry[]
  results               StudentResult[]
  homeworkCompletions   HomeworkCompletion[]
  documents             Document[]

  @@unique([schoolId, id])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, fullName])
  @@map("students")
}

/// Per-school definitions for students.custom_fields (no per-school schema changes).
model StudentFieldDefinition {
  id        String       @id @default(uuid(7)) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  key       String
  label     String
  dataType  String       @map("data_type")
  required  Boolean      @default(false)
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
  @@map("student_field_definitions")
}

/// One row per student per academic year. Promotion/transfer creates or closes rows, never rewrites history.
/// Partial unique (school_id, section_id, roll_number) WHERE status = 'active'.
model StudentEnrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  rollNumber     Int?             @map("roll_number") @db.SmallInt
  status         EnrollmentStatus @default(active)
  startedOn      DateTime         @map("started_on") @db.Date
  endedOn        DateTime?        @map("ended_on") @db.Date
  endReason      String?          @map("end_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?          @map("created_by") @db.Uuid

  student      Student      @relation(fields: [schoolId, studentId], references: [schoolId, id])
  academicYear AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  section      Section      @relation(fields: [schoolId, sectionId], references: [schoolId, id])

  @@unique([schoolId, studentId, academicYearId])
  @@index([schoolId, sectionId, status])
  @@map("student_enrollments")
}

/// Guardian contact on the student record. mobile (E.164) is what parent OTP login matches.
/// Only status = active rows create parent links; student-entered rows start as pending.
model StudentGuardian {
  id          String           @id @default(uuid(7)) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  name        String
  relation    GuardianRelation
  mobile      String
  isPrimary   Boolean          @default(false) @map("is_primary")
  status      GuardianStatus   @default(active)
  source      GuardianSource
  confirmedBy String?          @map("confirmed_by") @db.Uuid
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?          @map("created_by") @db.Uuid
  updatedBy   String?          @map("updated_by") @db.Uuid

  student Student             @relation(fields: [schoolId, studentId], references: [schoolId, id])
  links   ParentStudentLink[]

  @@unique([schoolId, id])
  @@unique([schoolId, studentId, mobile])
  @@index([mobile, status])
  @@map("student_guardians")
}

/// Parent user <-> student, derived from a verified OTP mobile matching an active guardian mobile.
/// Created/refreshed at parent login; revoked when the guardian is removed or the mobile changes.
model ParentStudentLink {
  id           String           @id @default(uuid(7)) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  guardianId   String           @map("guardian_id") @db.Uuid
  status       ParentLinkStatus @default(active)
  linkedAt     DateTime         @default(now()) @map("linked_at") @db.Timestamptz
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz
  revokeReason String?          @map("revoke_reason")

  user     User            @relation(fields: [userId], references: [id])
  student  Student         @relation(fields: [schoolId, studentId], references: [schoolId, id])
  guardian StudentGuardian @relation(fields: [schoolId, guardianId], references: [schoolId, id])

  @@unique([userId, guardianId])
  @@index([userId, status])
  @@index([schoolId, studentId])
  @@map("parent_student_links")
}

/// Configurable department labels (non-teaching dashboards, tasks, assets).
model Department {
  id        String       @id @default(uuid(7)) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  name      String
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  school             School              @relation(fields: [schoolId], references: [id])
  staff              Staff[]
  tasks              Task[]
  assets             Asset[]
  assetAssignments   AssetAssignment[]
  inventoryMovements InventoryMovement[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("departments")
}

/// Every school employee with a username (VP, Admin, teaching, non-teaching; Principal optional).
/// designation is FREE TEXT. user_id stays null until the account exists: for teachers, until TEACHER_ADDITION
/// is approved (credentials only after approval).
model Staff {
  id                 String      @id @default(uuid(7)) @db.Uuid
  schoolId           String      @map("school_id") @db.Uuid
  userId             String?     @map("user_id") @db.Uuid
  fullName           String      @map("full_name")
  staffType          StaffType   @map("staff_type")
  designation        String
  departmentId       String?     @map("department_id") @db.Uuid
  mobile             String?
  email              String?
  joiningDate        DateTime?   @map("joining_date") @db.Date
  status             StaffStatus @default(pending_approval)
  profileCompletedAt DateTime?   @map("profile_completed_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?     @map("created_by") @db.Uuid
  updatedBy          String?     @map("updated_by") @db.Uuid

  school             School                        @relation(fields: [schoolId], references: [id])
  user               User?                         @relation(fields: [userId], references: [id])
  department         Department?                   @relation(fields: [schoolId, departmentId], references: [schoolId, id])
  qualifications     TeacherSubjectQualification[]
  assignments        TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  unavailability     TeacherAvailability[]
  absences           Substitution[]                @relation("SubstitutionAbsent")
  coverings          Substitution[]                @relation("SubstitutionSubstitute")
  attendance         StaffAttendance[]
  leaveRequests      LeaveRequest[]
  duties             DutySchedule[]
  tasks              Task[]
  assetAssignments   AssetAssignment[]
  inventoryMovements InventoryMovement[]
  homework           Homework[]
  lessonPlans        LessonPlan[]
  documents          Document[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@index([schoolId, staffType, status])
  @@map("staff")
}

/// Subjects a teacher CAN teach (qualification). Separate from current assignments.
model TeacherSubjectQualification {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  staff   Staff   @relation(fields: [schoolId, staffId], references: [schoolId, id])
  subject Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id])

  @@unique([schoolId, staffId, subjectId])
  @@map("teacher_subject_qualifications")
}

/// CURRENT and past assignments. Never overwritten: a trigger allows only setting valid_to on an open row; a
/// change closes the old row and inserts a new one (after TEACHER_ASSIGNMENT_CHANGE approval).
/// CHECK (type = 'class_teacher') = (subject_id IS NULL).
/// Partial unique: one open class teacher per section (WHERE type = 'class_teacher' AND valid_to IS NULL).
model TeacherAssignment {
  id                String                @id @default(uuid(7)) @db.Uuid
  schoolId          String                @map("school_id") @db.Uuid
  academicYearId    String                @map("academic_year_id") @db.Uuid
  staffId           String                @map("staff_id") @db.Uuid
  sectionId         String                @map("section_id") @db.Uuid
  subjectId         String?               @map("subject_id") @db.Uuid
  type              TeacherAssignmentType
  validFrom         DateTime              @map("valid_from") @db.Date
  validTo           DateTime?             @map("valid_to") @db.Date
  approvalRequestId String?               @map("approval_request_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy         String?               @map("created_by") @db.Uuid

  academicYear    AcademicYear     @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  staff           Staff            @relation(fields: [schoolId, staffId], references: [schoolId, id])
  section         Section          @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  subject         Subject?         @relation(fields: [schoolId, subjectId], references: [schoolId, id])
  approvalRequest ApprovalRequest? @relation(fields: [schoolId, approvalRequestId], references: [schoolId, id])

  @@index([schoolId, staffId, validTo])
  @@index([schoolId, sectionId, validTo])
  @@map("teacher_assignments")
}

// ============================================================================================
// Attendance and leave
// ============================================================================================

/// One per section per day: who submitted, when. Drives "marked / not marked" and the same-day edit rule
/// (teacher may resubmit only while attendance_date is today in the school's timezone).
/// idempotency_key stores the Idempotency-Key of the bulk submit.
model AttendanceRegister {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  attendanceDate DateTime @map("attendance_date") @db.Date
  presentCount   Int      @map("present_count") @db.SmallInt
  absentCount    Int      @map("absent_count") @db.SmallInt
  submittedBy    String   @map("submitted_by") @db.Uuid
  submittedAt    DateTime @map("submitted_at") @db.Timestamptz
  idempotencyKey String?  @map("idempotency_key")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  section Section @relation(fields: [schoolId, sectionId], references: [schoolId, id])

  @@unique([schoolId, sectionId, attendanceDate])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, attendanceDate])
  @@map("attendance_registers")
}

/// PRESENT or ABSENT only ("Reset" is a UI action). Monthly range partitions on attendance_date
/// (~4.4 crore rows/year at pilot scale). Partition key is part of the primary key.
model StudentAttendance {
  id             String           @default(uuid(7)) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  studentId      String           @map("student_id") @db.Uuid
  sectionId      String           @map("section_id") @db.Uuid
  status         AttendanceStatus
  markedBy       String           @map("marked_by") @db.Uuid
  markedAt       DateTime         @map("marked_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy      String?          @map("updated_by") @db.Uuid

  student     Student                @relation(fields: [schoolId, studentId], references: [schoolId, id])
  section     Section                @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  corrections AttendanceCorrection[]

  @@id([id, attendanceDate])
  @@unique([schoolId, studentId, attendanceDate])
  @@index([schoolId, sectionId, attendanceDate])
  @@map("student_attendance")
}

/// Change after the day: Admin only, reason mandatory (CHECK length(trim(reason)) > 0), plus an audit row.
model AttendanceCorrection {
  id             String           @id @default(uuid(7)) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  attendanceId   String           @map("attendance_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  studentId      String           @map("student_id") @db.Uuid
  oldStatus      AttendanceStatus @map("old_status")
  newStatus      AttendanceStatus @map("new_status")
  reason         String
  correctedBy    String           @map("corrected_by") @db.Uuid
  correctedAt    DateTime         @default(now()) @map("corrected_at") @db.Timestamptz

  attendance StudentAttendance @relation(fields: [attendanceId, attendanceDate], references: [id, attendanceDate])
  student    Student           @relation(fields: [schoolId, studentId], references: [schoolId, id])

  @@index([schoolId, studentId, attendanceDate])
  @@map("attendance_corrections")
}

/// Staff attendance, manual only (no biometric). on_leave is written when leave is approved.
model StaffAttendance {
  id             String                @id @default(uuid(7)) @db.Uuid
  schoolId       String                @map("school_id") @db.Uuid
  staffId        String                @map("staff_id") @db.Uuid
  attendanceDate DateTime              @map("attendance_date") @db.Date
  status         StaffAttendanceStatus
  leaveRequestId String?               @map("leave_request_id") @db.Uuid
  markedBy       String                @map("marked_by") @db.Uuid
  markedAt       DateTime              @map("marked_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  staff        Staff         @relation(fields: [schoolId, staffId], references: [schoolId, id])
  leaveRequest LeaveRequest? @relation(fields: [schoolId, leaveRequestId], references: [schoolId, id])

  @@unique([schoolId, staffId, attendanceDate])
  @@index([schoolId, attendanceDate])
  @@map("staff_attendance")
}

/// Configurable per school (seeded: Casual, Sick, Other).
model LeaveType {
  id        String       @id @default(uuid(7)) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  name      String
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  school        School         @relation(fields: [schoolId], references: [id])
  leaveRequests LeaveRequest[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("leave_types")
}

/// Staff and non-teaching only (never students). Decided through a STAFF_LEAVE approval (Principal or VP).
/// CHECK to_date >= from_date.
model LeaveRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  schoolId          String             @map("school_id") @db.Uuid
  staffId           String             @map("staff_id") @db.Uuid
  leaveTypeId       String             @map("leave_type_id") @db.Uuid
  fromDate          DateTime           @map("from_date") @db.Date
  toDate            DateTime           @map("to_date") @db.Date
  reason            String
  status            LeaveRequestStatus @default(pending)
  approvalRequestId String?            @map("approval_request_id") @db.Uuid
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?            @map("created_by") @db.Uuid

  staff           Staff             @relation(fields: [schoolId, staffId], references: [schoolId, id])
  leaveType       LeaveType         @relation(fields: [schoolId, leaveTypeId], references: [schoolId, id])
  approvalRequest ApprovalRequest?  @relation(fields: [schoolId, approvalRequestId], references: [schoolId, id])
  staffAttendance StaffAttendance[]

  @@unique([schoolId, id])
  @@index([schoolId, staffId, fromDate])
  @@index([schoolId, status])
  @@map("leave_requests")
}

// ============================================================================================
// Timetable and substitution
// ============================================================================================

/// One version per change. Partial unique: one published timetable per section (WHERE status = 'published').
model Timetable {
  id                String          @id @default(uuid(7)) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  academicYearId    String          @map("academic_year_id") @db.Uuid
  sectionId         String          @map("section_id") @db.Uuid
  version           Int             @db.SmallInt
  status            TimetableStatus @default(draft)
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  effectiveFrom     DateTime?       @map("effective_from") @db.Date
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz
  publishedBy       String?         @map("published_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?         @map("created_by") @db.Uuid

  academicYear    AcademicYear     @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  section         Section          @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  approvalRequest ApprovalRequest? @relation(fields: [schoolId, approvalRequestId], references: [schoolId, id])
  entries         TimetableEntry[]

  @@unique([schoolId, id])
  @@unique([schoolId, sectionId, version])
  @@map("timetables")
}

/// Day, period, subject, teacher ONLY (no room, no break). day_of_week ISO 1-7, period_no 1..period_count.
/// Teacher double-booking across sections is checked by the app on validate/approve (not storable as a constraint).
model TimetableEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  timetableId String   @map("timetable_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") @db.SmallInt
  periodNo    Int      @map("period_no") @db.SmallInt
  subjectId   String   @map("subject_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  timetable     Timetable      @relation(fields: [schoolId, timetableId], references: [schoolId, id])
  subject       Subject        @relation(fields: [schoolId, subjectId], references: [schoolId, id])
  staff         Staff          @relation(fields: [schoolId, staffId], references: [schoolId, id])
  substitutions Substitution[]

  @@unique([schoolId, id])
  @@unique([schoolId, timetableId, dayOfWeek, periodNo])
  @@index([schoolId, staffId, dayOfWeek, periodNo])
  @@map("timetable_entries")
}

/// Slots a teacher is NOT available (used by conflict detection).
model TeacherAvailability {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  periodNo  Int      @map("period_no") @db.SmallInt
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  staff Staff @relation(fields: [schoolId, staffId], references: [schoolId, id])

  @@unique([schoolId, staffId, dayOfWeek, periodNo])
  @@map("teacher_availability")
}

/// Assigned manually by Admin. Partial unique: a substitute covers one class per period
/// (school_id, substitute_staff_id, substitution_date, period_no) WHERE status = 'assigned'.
model Substitution {
  id                String             @id @default(uuid(7)) @db.Uuid
  schoolId          String             @map("school_id") @db.Uuid
  substitutionDate  DateTime           @map("substitution_date") @db.Date
  periodNo          Int                @map("period_no") @db.SmallInt
  sectionId         String             @map("section_id") @db.Uuid
  timetableEntryId  String?            @map("timetable_entry_id") @db.Uuid
  absentStaffId     String             @map("absent_staff_id") @db.Uuid
  substituteStaffId String             @map("substitute_staff_id") @db.Uuid
  reason            String?
  status            SubstitutionStatus @default(assigned)
  assignedBy        String             @map("assigned_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  section         Section         @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  timetableEntry  TimetableEntry? @relation(fields: [schoolId, timetableEntryId], references: [schoolId, id])
  absentStaff     Staff           @relation("SubstitutionAbsent", fields: [schoolId, absentStaffId], references: [schoolId, id])
  substituteStaff Staff           @relation("SubstitutionSubstitute", fields: [schoolId, substituteStaffId], references: [schoolId, id])

  @@index([schoolId, substitutionDate])
  @@map("substitutions")
}

// ============================================================================================
// Exams, results, homework, lesson plans
// ============================================================================================

model Exam {
  id             String     @id @default(uuid(7)) @db.Uuid
  schoolId       String     @map("school_id") @db.Uuid
  academicYearId String     @map("academic_year_id") @db.Uuid
  name           String
  examType       String?    @map("exam_type")
  status         ExamStatus @default(draft)
  startsOn       DateTime?  @map("starts_on") @db.Date
  endsOn         DateTime?  @map("ends_on") @db.Date
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?    @map("created_by") @db.Uuid

  academicYear   AcademicYear    @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  subjects       ExamSubject[]
  resultSets     ResultSet[]
  calendarEvents CalendarEvent[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, name])
  @@map("exams")
}

/// One class + subject in an exam (replaces a separate exam_classes table).
model ExamSubject {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  examId    String    @map("exam_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  subjectId String    @map("subject_id") @db.Uuid
  examDate  DateTime? @map("exam_date") @db.Date
  maxMarks  Decimal   @map("max_marks") @db.Decimal(6, 2)
  passMarks Decimal?  @map("pass_marks") @db.Decimal(6, 2)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid

  exam    Exam         @relation(fields: [schoolId, examId], references: [schoolId, id])
  class   Class        @relation(fields: [schoolId, classId], references: [schoolId, id])
  subject Subject      @relation(fields: [schoolId, subjectId], references: [schoolId, id])
  marks   MarksEntry[]

  @@unique([schoolId, id])
  @@unique([schoolId, examId, classId, subjectId])
  @@map("exam_subjects")
}

/// Entered by the assigned subject teacher. CHECK is_absent OR marks_obtained IS NOT NULL;
/// marks_obtained <= exam_subjects.max_marks is an app check (cross-table).
model MarksEntry {
  id            String           @id @default(uuid(7)) @db.Uuid
  schoolId      String           @map("school_id") @db.Uuid
  examSubjectId String           @map("exam_subject_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  marksObtained Decimal?         @map("marks_obtained") @db.Decimal(6, 2)
  isAbsent      Boolean          @default(false) @map("is_absent")
  remarks       String?
  status        MarksEntryStatus @default(draft)
  enteredBy     String           @map("entered_by") @db.Uuid
  submittedAt   DateTime?        @map("submitted_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  examSubject ExamSubject @relation(fields: [schoolId, examSubjectId], references: [schoolId, id])
  student     Student     @relation(fields: [schoolId, studentId], references: [schoolId, id])

  @@unique([schoolId, examSubjectId, studentId])
  @@index([schoolId, studentId])
  @@map("marks_entries")
}

/// Unit of result approval and publication: one exam, one class, one version. Only published sets are
/// visible to students and parents. A rejected set is kept; recompiling creates version + 1.
model ResultSet {
  id                String          @id @default(uuid(7)) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  examId            String          @map("exam_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  version           Int             @default(1) @db.SmallInt
  status            ResultSetStatus @default(compiled)
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  compiledBy        String          @map("compiled_by") @db.Uuid
  compiledAt        DateTime        @map("compiled_at") @db.Timestamptz
  publishedBy       String?         @map("published_by") @db.Uuid
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  exam            Exam             @relation(fields: [schoolId, examId], references: [schoolId, id])
  class           Class            @relation(fields: [schoolId, classId], references: [schoolId, id])
  approvalRequest ApprovalRequest? @relation(fields: [schoolId, approvalRequestId], references: [schoolId, id])
  results         StudentResult[]

  @@unique([schoolId, id])
  @@unique([schoolId, examId, classId, version])
  @@map("result_sets")
}

/// Compiled result per student = report-card snapshot. subject_lines JSONB: [{subjectId, name, max, obtained,
/// absent, grade}]. Never edited after the set is published.
model StudentResult {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  resultSetId   String   @map("result_set_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  sectionName   String   @map("section_name")
  totalObtained Decimal  @map("total_obtained") @db.Decimal(7, 2)
  totalMax      Decimal  @map("total_max") @db.Decimal(7, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  grade         String?
  resultLabel   String?  @map("result_label")
  subjectLines  Json     @map("subject_lines")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  resultSet ResultSet @relation(fields: [schoolId, resultSetId], references: [schoolId, id])
  student   Student   @relation(fields: [schoolId, studentId], references: [schoolId, id])

  @@unique([schoolId, resultSetId, studentId])
  @@index([schoolId, studentId])
  @@map("student_results")
}

/// Homework for a section and subject. No student file submissions in V1 (completion only).
model Homework {
  id             String         @id @default(uuid(7)) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  sectionId      String         @map("section_id") @db.Uuid
  subjectId      String         @map("subject_id") @db.Uuid
  staffId        String         @map("staff_id") @db.Uuid
  title          String
  description    String?
  assignedOn     DateTime       @map("assigned_on") @db.Date
  dueOn          DateTime       @map("due_on") @db.Date
  status         HomeworkStatus @default(draft)
  publishedAt    DateTime?      @map("published_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?        @map("created_by") @db.Uuid

  academicYear AcademicYear         @relation(fields: [schoolId, academicYearId], references: [schoolId, id])
  section      Section              @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  subject      Subject              @relation(fields: [schoolId, subjectId], references: [schoolId, id])
  staff        Staff                @relation(fields: [schoolId, staffId], references: [schoolId, id])
  completions  HomeworkCompletion[]

  @@unique([schoolId, id])
  @@index([schoolId, sectionId, dueOn])
  @@map("homework")
}

/// Marked by the teacher; shown read-only to the student and parent.
model HomeworkCompletion {
  id         String                   @id @default(uuid(7)) @db.Uuid
  schoolId   String                   @map("school_id") @db.Uuid
  homeworkId String                   @map("homework_id") @db.Uuid
  studentId  String                   @map("student_id") @db.Uuid
  status     HomeworkCompletionStatus
  markedBy   String                   @map("marked_by") @db.Uuid
  markedAt   DateTime                 @map("marked_at") @db.Timestamptz

  homework Homework @relation(fields: [schoolId, homeworkId], references: [schoolId, id])
  student  Student  @relation(fields: [schoolId, studentId], references: [schoolId, id])

  @@unique([schoolId, homeworkId, studentId])
  @@map("homework_completions")
}

model LessonPlan {
  id          String           @id @default(uuid(7)) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  staffId     String           @map("staff_id") @db.Uuid
  sectionId   String           @map("section_id") @db.Uuid
  subjectId   String           @map("subject_id") @db.Uuid
  chapter     String
  topic       String
  objectives  String?
  plannedOn   DateTime         @map("planned_on") @db.Date
  status      LessonPlanStatus @default(planned)
  completedOn DateTime?        @map("completed_on") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  staff   Staff   @relation(fields: [schoolId, staffId], references: [schoolId, id])
  section Section @relation(fields: [schoolId, sectionId], references: [schoolId, id])
  subject Subject @relation(fields: [schoolId, subjectId], references: [schoolId, id])

  @@index([schoolId, staffId, plannedOn])
  @@map("lesson_plans")
}

// ============================================================================================
// Approvals (generic engine)
// ============================================================================================

/// payload = snapshot of what is being approved (validated per type by the app). decided_by = the real
/// approver (Principal or VP, by permission approvals.decide; never the requester). First decision wins
/// (UPDATE ... WHERE status = 'pending'). CHECK status <> 'rejected' OR length(trim(rejection_reason)) > 0.
/// Resubmission = new row, version + 1, parent_request_id -> the rejected one. History is never overwritten.
model ApprovalRequest {
  id              String         @id @default(uuid(7)) @db.Uuid
  schoolId        String         @map("school_id") @db.Uuid
  type            ApprovalType
  entityType      String         @map("entity_type")
  entityId        String?        @map("entity_id") @db.Uuid
  payload         Json
  status          ApprovalStatus @default(draft)
  version         Int            @default(1) @db.SmallInt
  parentRequestId String?        @unique @map("parent_request_id") @db.Uuid
  requestedBy     String         @map("requested_by") @db.Uuid
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz
  decidedBy       String?        @map("decided_by") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz
  decisionComment String?        @map("decision_comment")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id])
  parentRequest      ApprovalRequest?    @relation("ApprovalResubmission", fields: [parentRequestId], references: [id])
  nextRequest        ApprovalRequest?    @relation("ApprovalResubmission")
  actions            ApprovalAction[]
  teacherAssignments TeacherAssignment[]
  leaveRequests      LeaveRequest[]
  timetables         Timetable[]
  resultSets         ResultSet[]
  importJobs         ImportJob[]

  @@unique([schoolId, id])
  @@index([schoolId, status, submittedAt])
  @@index([schoolId, requestedBy])
  @@index([schoolId, entityType, entityId])
  @@map("approval_requests")
}

/// Append-only history of every step (app role: INSERT and SELECT only).
model ApprovalAction {
  id          String             @id @default(uuid(7)) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  requestId   String             @map("request_id") @db.Uuid
  actorUserId String             @map("actor_user_id") @db.Uuid
  actorRole   Role               @map("actor_role")
  action      ApprovalActionType
  comment     String?
  reason      String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz

  request ApprovalRequest @relation(fields: [schoolId, requestId], references: [schoolId, id])

  @@index([schoolId, requestId, createdAt])
  @@map("approval_actions")
}

// ============================================================================================
// Notices, calendar, notifications
// ============================================================================================

/// One-way broadcast (not messaging). No attachments in V1.
model Notice {
  id          String       @id @default(uuid(7)) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  title       String
  body        String
  status      NoticeStatus @default(draft)
  publishAt   DateTime?    @map("publish_at") @db.Timestamptz
  publishedAt DateTime?    @map("published_at") @db.Timestamptz
  publishedBy String?      @map("published_by") @db.Uuid
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?      @map("created_by") @db.Uuid
  updatedBy   String?      @map("updated_by") @db.Uuid

  school    School           @relation(fields: [schoolId], references: [id])
  audiences NoticeAudience[]

  @@unique([schoolId, id])
  @@index([schoolId, status, publishedAt])
  @@map("notices")
}

/// CHECK: class -> class_id; section -> section_id; staff_group -> staff_group; whole_school -> none.
model NoticeAudience {
  id           String             @id @default(uuid(7)) @db.Uuid
  schoolId     String             @map("school_id") @db.Uuid
  noticeId     String             @map("notice_id") @db.Uuid
  audienceType NoticeAudienceType @map("audience_type")
  classId      String?            @map("class_id") @db.Uuid
  sectionId    String?            @map("section_id") @db.Uuid
  staffGroup   StaffGroup?        @map("staff_group")

  notice  Notice   @relation(fields: [schoolId, noticeId], references: [schoolId, id])
  class   Class?   @relation(fields: [schoolId, classId], references: [schoolId, id])
  section Section? @relation(fields: [schoolId, sectionId], references: [schoolId, id])

  @@index([schoolId, noticeId])
  @@map("notice_audiences")
}

/// Holidays, exams, meetings, activities (holidays are calendar events, not a separate table).
model CalendarEvent {
  id          String            @id @default(uuid(7)) @db.Uuid
  schoolId    String            @map("school_id") @db.Uuid
  type        CalendarEventType
  title       String
  description String?
  startsOn    DateTime          @map("starts_on") @db.Date
  endsOn      DateTime          @map("ends_on") @db.Date
  audience    CalendarAudience  @default(everyone)
  examId      String?           @map("exam_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?           @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])
  exam   Exam?  @relation(fields: [schoolId, examId], references: [schoolId, id])

  @@index([schoolId, startsOn])
  @@map("calendar_events")
}

/// In-app notification (push is sent from the same row by the worker). recipient is always a user (parents are
/// users after their first OTP login). student_id gives a parent the child context; school_id the school
/// context (null only for platform events such as verification decisions). Monthly partitions, 90-day retention.
model Notification {
  id              String            @default(uuid(7)) @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  schoolId        String?           @map("school_id") @db.Uuid
  recipientUserId String            @map("recipient_user_id") @db.Uuid
  studentId       String?           @map("student_id") @db.Uuid
  event           NotificationEvent
  title           String
  body            String
  entityType      String?           @map("entity_type")
  entityId        String?           @map("entity_id") @db.Uuid
  payload         Json              @default("{}")
  readAt          DateTime?         @map("read_at") @db.Timestamptz

  school    School? @relation(fields: [schoolId], references: [id])
  recipient User    @relation(fields: [recipientUserId], references: [id])

  @@id([id, createdAt])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Domain events written in the same transaction as the change; a relay claims them through a SECURITY DEFINER
/// function and pushes them to BullMQ. Published rows are purged after 7 days.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  schoolId    String?   @map("school_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  attempts    Int       @default(0) @db.SmallInt
  lastError   String?   @map("last_error")

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

// ============================================================================================
// Non-teaching staff
// ============================================================================================

/// Either a weekly duty (day_of_week) or a one-off (duty_date). CHECK exactly one is set.
model DutySchedule {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  dutyDate  DateTime? @map("duty_date") @db.Date
  dayOfWeek Int?      @map("day_of_week") @db.SmallInt
  startTime DateTime  @map("start_time") @db.Time(0)
  endTime   DateTime  @map("end_time") @db.Time(0)
  location  String?
  duty      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid

  staff Staff @relation(fields: [schoolId, staffId], references: [schoolId, id])

  @@index([schoolId, staffId])
  @@map("duty_schedules")
}

model Task {
  id                String       @id @default(uuid(7)) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  title             String
  description       String?
  assignedToStaffId String       @map("assigned_to_staff_id") @db.Uuid
  departmentId      String?      @map("department_id") @db.Uuid
  assignedBy        String       @map("assigned_by") @db.Uuid
  dueAt             DateTime?    @map("due_at") @db.Timestamptz
  priority          TaskPriority @default(medium)
  status            TaskStatus   @default(open)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  assignedTo Staff       @relation(fields: [schoolId, assignedToStaffId], references: [schoolId, id])
  department Department? @relation(fields: [schoolId, departmentId], references: [schoolId, id])

  @@index([schoolId, assignedToStaffId, status])
  @@map("tasks")
}

/// Individually tracked item (projector, laptop). Counted stock lives in inventory_items.
model Asset {
  id           String         @id @default(uuid(7)) @db.Uuid
  schoolId     String         @map("school_id") @db.Uuid
  assetCode    String         @map("asset_code")
  name         String
  category     String
  departmentId String?        @map("department_id") @db.Uuid
  condition    AssetCondition @default(good)
  status       AssetStatus    @default(in_stock)
  purchaseDate DateTime?      @map("purchase_date") @db.Date
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?        @map("created_by") @db.Uuid

  school              School               @relation(fields: [schoolId], references: [id])
  department          Department?          @relation(fields: [schoolId, departmentId], references: [schoolId, id])
  assignments         AssetAssignment[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([schoolId, id])
  @@unique([schoolId, assetCode])
  @@map("assets")
}

/// CHECK staff_id IS NOT NULL OR department_id IS NOT NULL. Partial unique: one open assignment per asset
/// (WHERE returned_at IS NULL).
model AssetAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  assetId      String    @map("asset_id") @db.Uuid
  staffId      String?   @map("staff_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  assignedBy   String    @map("assigned_by") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz
  notes        String?

  asset      Asset       @relation(fields: [schoolId, assetId], references: [schoolId, id])
  staff      Staff?      @relation(fields: [schoolId, staffId], references: [schoolId, id])
  department Department? @relation(fields: [schoolId, departmentId], references: [schoolId, id])

  @@index([schoolId, assetId])
  @@map("asset_assignments")
}

/// Counted stock. CHECK quantity_on_hand >= 0; changed only together with an inventory_movements row.
model InventoryItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  name           String
  category       String?
  unit           String
  quantityOnHand Int          @default(0) @map("quantity_on_hand")
  reorderLevel   Int?         @map("reorder_level")
  status         RecordStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?      @map("created_by") @db.Uuid

  school    School              @relation(fields: [schoolId], references: [id])
  movements InventoryMovement[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@map("inventory_items")
}

/// Issue/return/stock-in/adjustment history (append-only). CHECK quantity > 0.
model InventoryMovement {
  id           String                @id @default(uuid(7)) @db.Uuid
  schoolId     String                @map("school_id") @db.Uuid
  itemId       String                @map("item_id") @db.Uuid
  type         InventoryMovementType
  quantity     Int
  staffId      String?               @map("staff_id") @db.Uuid
  departmentId String?               @map("department_id") @db.Uuid
  note         String?
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String                @map("created_by") @db.Uuid

  item       InventoryItem @relation(fields: [schoolId, itemId], references: [schoolId, id])
  staff      Staff?        @relation(fields: [schoolId, staffId], references: [schoolId, id])
  department Department?   @relation(fields: [schoolId, departmentId], references: [schoolId, id])

  @@index([schoolId, itemId, createdAt])
  @@map("inventory_movements")
}

model MaintenanceRequest {
  id             String            @id @default(uuid(7)) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  assetId        String?           @map("asset_id") @db.Uuid
  title          String
  description    String?
  raisedBy       String            @map("raised_by") @db.Uuid
  status         MaintenanceStatus @default(open)
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz
  resolutionNote String?           @map("resolution_note")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id])
  asset  Asset? @relation(fields: [schoolId, assetId], references: [schoolId, id])

  @@index([schoolId, status])
  @@map("maintenance_requests")
}

// ============================================================================================
// Import, files, documents
// ============================================================================================

/// One Excel upload (3 templates). A teaching-staff import raises one TEACHER_ADDITION approval for the job;
/// credentials are generated only after approval.
model ImportJob {
  id                String          @id @default(uuid(7)) @db.Uuid
  schoolId          String          @map("school_id") @db.Uuid
  type              ImportType
  fileId            String          @map("file_id") @db.Uuid
  status            ImportJobStatus @default(uploaded)
  totalRows         Int             @default(0) @map("total_rows")
  validRows         Int             @default(0) @map("valid_rows")
  invalidRows       Int             @default(0) @map("invalid_rows")
  importedRows      Int             @default(0) @map("imported_rows")
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  createdBy         String?         @map("created_by") @db.Uuid

  school          School           @relation(fields: [schoolId], references: [id])
  file            File             @relation(fields: [schoolId, fileId], references: [schoolId, id])
  approvalRequest ApprovalRequest? @relation(fields: [schoolId, approvalRequestId], references: [schoolId, id])
  rows            ImportRow[]

  @@unique([schoolId, id])
  @@index([schoolId, createdAt])
  @@map("import_jobs")
}

/// Row-level validation result. raw_data holds personal data: rows are purged 30 days after the job closes.
model ImportRow {
  id              String           @id @default(uuid(7)) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  jobId           String           @map("job_id") @db.Uuid
  rowNumber       Int              @map("row_number")
  rawData         Json             @map("raw_data")
  errors          Json             @default("[]")
  outcome         ImportRowOutcome @default(pending)
  createdEntityId String?          @map("created_entity_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  job ImportJob @relation(fields: [schoolId, jobId], references: [schoolId, id])

  @@unique([schoolId, jobId, rowNumber])
  @@map("import_rows")
}

/// Object-storage metadata. storage_key starts with '<school_id>/' (CHECK); private bucket, presigned URLs.
model File {
  id           String      @id @default(uuid(7)) @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  purpose      FilePurpose
  storageKey   String      @unique @map("storage_key")
  originalName String      @map("original_name")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  status       FileStatus  @default(pending_upload)
  uploadedBy   String      @map("uploaded_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  school     School      @relation(fields: [schoolId], references: [id])
  importJobs ImportJob[]
  documents  Document[]

  @@unique([schoolId, id])
  @@map("files")
}

/// Admin-side documents (not student-facing). Optional link to a student, staff member or year.
model Document {
  id             String         @id @default(uuid(7)) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  fileId         String         @map("file_id") @db.Uuid
  title          String
  category       String
  studentId      String?        @map("student_id") @db.Uuid
  staffId        String?        @map("staff_id") @db.Uuid
  academicYearId String?        @map("academic_year_id") @db.Uuid
  access         DocumentAccess @default(admin_only)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?        @map("created_by") @db.Uuid

  file         File          @relation(fields: [schoolId, fileId], references: [schoolId, id])
  student      Student?      @relation(fields: [schoolId, studentId], references: [schoolId, id])
  staff        Staff?        @relation(fields: [schoolId, staffId], references: [schoolId, id])
  academicYear AcademicYear? @relation(fields: [schoolId, academicYearId], references: [schoolId, id])

  @@index([schoolId, category])
  @@map("documents")
}

// ============================================================================================
// Audit
// ============================================================================================

/// Append-only (no UPDATE/DELETE: privileges revoked AND a trigger that raises, even for the owner).
/// Monthly range partitions on created_at. Existing columns kept (target_type/target_id = the record).
/// Never holds passwords, OTPs, tokens or typed login identifiers. actor_role is text because it can be a
/// school role or a platform role. module is nullable only for rows written before this expansion.
model AuditLog {
  id          String        @default(uuid(7)) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  schoolId    String?       @map("school_id") @db.Uuid
  actorUserId String?       @map("actor_user_id") @db.Uuid
  actorRole   String?       @map("actor_role")
  category    AuditCategory @default(general)
  module      AuditModule?
  action      String
  targetType  String?       @map("target_type")
  targetId    String?       @map("target_id") @db.Uuid
  oldValue    Json?         @map("old_value")
  newValue    Json?         @map("new_value")
  reason      String?
  ip          String?
  sessionId   String?       @map("session_id") @db.Uuid
  metadata    Json          @default("{}")

  @@id([id, createdAt])
  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([schoolId, module, createdAt])
  @@index([schoolId, targetType, targetId])
  @@map("audit_logs")
}
