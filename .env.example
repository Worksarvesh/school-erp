# Copy to `.env` (never commit `.env`). Every value below is a placeholder.
# Use separate values for development, staging and production.

NODE_ENV=development
APP_ENV=development            # development | staging | production

# Local Docker PostgreSQL (docker-compose.yml). Pick your own local-only passwords.
DB_SUPERUSER_PASSWORD=<local-only-password>
DB_OWNER_PASSWORD=<local-only-password>
DB_APP_PASSWORD=<local-only-password>

# API (apps/api)
API_PORT=3000
# App role: no BYPASSRLS, not the table owner. Used by the running API.
DATABASE_URL=postgresql://school_erp_app:<DB_APP_PASSWORD>@localhost:5434/school_erp
# Owner role: runs migrations only. Never used by the running API.
MIGRATION_DATABASE_URL=postgresql://school_erp_owner:<DB_OWNER_PASSWORD>@localhost:5434/school_erp
# Signs access tokens (HS256). At least 32 bytes or the API refuses to start. Generate one with:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_ACCESS_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
# OTP (Principal and Parent login). Until real SMS exists the only provider is "fixed": every code is
# OTP_FIXED_CODE and nothing is sent. The API REFUSES TO START with "fixed" when APP_ENV or NODE_ENV
# is production. Staging may use it only with demo/test data. Defaults: fixed and 999999 in
# development/test; other environments must set OTP_PROVIDER explicitly.
OTP_PROVIDER=fixed
OTP_FIXED_CODE=999999
# HMAC key for stored OTP hashes. At least 32 bytes; generate it like JWT_ACCESS_SECRET.
OTP_HASH_SECRET=<generate-a-random-secret-of-at-least-32-bytes>
# Express "trust proxy". Keep false unless the API sits behind a proxy you control
# (then e.g. 1 = one hop); otherwise clients can spoof their IP and dodge rate limits.
TRUST_PROXY=false
# Optional rate-limit overrides (defaults shown).
# AUTH_RATE_LIMIT_PER_MINUTE=20
# LOGIN_FAILURES_PER_WINDOW=5

# Seed script (pnpm --filter api run seed): password for every demo user, 10-128 characters.
# Local only; the seed refuses to run when APP_ENV=production.
SEED_DEMO_PASSWORD=<pick-a-local-demo-password>

# Never put a database service-role key or any privileged secret in web/mobile env files.
# Only public, non-sensitive values may be exposed to clients.
