// Tenancy core (build order Step 1). RLS policies live in the SQL migrations, not here.
// Conventions: UUIDv7 ids generated by Prisma, snake_case in the database, camelCase in code.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // Partial unique indexes (WHERE ...) declared here, so migrate dev never drops them.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  principal
  school_admin
  vice_principal
  teacher
  non_teaching_staff
  office_clerk
  accountant
  student
  parent
  other_staff

  @@map("role")
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked

  @@map("membership_status")
}

/// unclaimed: in the school directory, no verified principal yet.
enum SchoolStatus {
  active
  suspended
  unclaimed

  @@map("school_status")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum PlatformRole {
  super_admin
  verifier

  @@map("platform_role")
}

enum ClientApp {
  school_app
  student_app

  @@map("client_app")
}

enum OtpPurpose {
  principal_registration
  principal_login
  parent_login

  @@map("otp_purpose")
}

enum VerificationStatus {
  pending
  approved
  rejected
  withdrawn

  @@map("verification_status")
}

/// Drives role-scoped audit reads (VP cannot read admin_account or branding rows).
enum AuditCategory {
  general
  admin_account
  branding
  security

  @@map("audit_category")
}

enum AuditModule {
  auth
  platform
  tenancy
  users
  academics
  students
  staff
  attendance
  leave
  timetable
  exams
  homework
  approvals
  notices
  calendar
  non_teaching
  imports
  documents

  @@map("audit_module")
}

/// A school is the tenant. RLS: visible when it is the current app.school_id, or (read-only)
/// when app.user_id has an active membership in it, or on the platform path.
/// code is sch + 4+ digits from school_code_seq (CHECK, NOT VALID until old demo codes are gone).
model School {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  code         String       @unique
  udiseCode    String?      @unique @map("udise_code")
  status       SchoolStatus @default(active)
  shardKey     Int          @default(0) @map("shard_key") @db.SmallInt
  addressLine  String?      @map("address_line")
  city         String?
  state        String?
  pinCode      String?      @map("pin_code")
  contactPhone String?      @map("contact_phone")
  contactEmail String?      @map("contact_email")
  logoFileId   String?      @map("logo_file_id") @db.Uuid
  timezone     String       @default("Asia/Kolkata")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?      @map("created_by") @db.Uuid
  updatedBy    String?      @map("updated_by") @db.Uuid

  memberships          SchoolMembership[]
  verificationRequests SchoolVerificationRequest[]

  @@map("schools")
}

/// Global person (one account, possibly in several schools). Owned by the users module.
/// RLS: visible when it is app.user_id, or when the user is a member of app.school_id.
/// phone (E.164) and email (lower case) are stored normalised, in plain text: a deliberate
/// deviation from "encrypt sensitive columns", to revisit in the DPDP review.
/// username: school-issued login (staff, students), unused until slice 3.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  fullName        String     @map("full_name")
  username        String?    @unique
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz
  email           String?    @unique
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  memberships   SchoolMembership[]
  credential    Credential?
  sessions      Session[]
  platformStaff PlatformStaff?
  verifications SchoolVerificationRequest[]

  @@map("users")
}

/// Password hash (argon2id). Owned by the auth module. RLS: only the user's own row (app.user_id).
/// must_change_password: set for temporary passwords; first login must change it.
model Credential {
  userId             String   @id @map("user_id") @db.Uuid
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime @map("password_changed_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("credentials")
}

/// One signed-in device. Owned by the auth module. RLS: only the user's own rows (app.user_id).
/// The refresh token is `<id>.<secret>`; only SHA-256 hashes of secrets are stored. Each refresh
/// moves token_hash to previous_token_hash; presenting the previous token again is reuse.
model Session {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash")
  previousTokenHash String?    @map("previous_token_hash")
  deviceName        String?    @map("device_name")
  /// Which app opened the session (audit and push routing only, never authorization).
  clientApp         ClientApp? @map("client_app")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt        DateTime   @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz
  revokedReason     String?    @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Append-only security log. Owned by the audit module. school_id is null for global events
/// (login). RLS: a school context reads its own rows; the app role may insert, never update/delete.
/// Never holds passwords, OTP codes, tokens or typed login identifiers.
/// Range-partitioned by month on created_at (partitions and the append-only trigger are in SQL).
model AuditLog {
  id          String        @default(uuid(7)) @db.Uuid
  schoolId    String?       @map("school_id") @db.Uuid
  actorUserId String?       @map("actor_user_id") @db.Uuid
  /// A school role or a platform role, as text.
  actorRole   String?       @map("actor_role")
  category    AuditCategory @default(general)
  module      AuditModule?
  action      String
  targetType  String?       @map("target_type")
  targetId    String?       @map("target_id") @db.Uuid
  oldValue    Json?         @map("old_value")
  newValue    Json?         @map("new_value")
  reason      String?
  ip          String?
  sessionId   String?       @map("session_id") @db.Uuid
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@id([id, createdAt])
  @@index([schoolId, module, createdAt])
  @@map("audit_logs")
}

/// One-time code for Principal (and later Parent) login. Owned by the auth module. The app role has
/// no grants: only the auth_otp_issue / auth_otp_verify SECURITY DEFINER functions touch it.
/// code_hash = HMAC-SHA256(code, OTP_HASH_SECRET); codes are never stored or logged.
model OtpChallenge {
  id          String     @id @default(uuid(7)) @db.Uuid
  purpose     OtpPurpose
  phone       String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0) @db.SmallInt
  maxAttempts Int        @default(5) @map("max_attempts") @db.SmallInt
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose, createdAt])
  @@map("otp_challenges")
}

/// New principal registration: a school picked from the directory (school_id) or "not listed"
/// (proposed_*). Owned by the platform module. RLS: the principal's own rows; the platform path.
/// Resubmitting a rejected request creates a new row pointing at it (previous_request_id).
model SchoolVerificationRequest {
  id                String             @id @default(uuid(7)) @db.Uuid
  principalUserId   String             @map("principal_user_id") @db.Uuid
  schoolId          String?            @map("school_id") @db.Uuid
  principalName     String             @map("principal_name")
  proposedName      String?            @map("proposed_name")
  proposedAddress   String?            @map("proposed_address")
  proposedPinCode   String?            @map("proposed_pin_code")
  status            VerificationStatus @default(pending)
  decidedByUserId   String?            @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz
  decisionReason    String?            @map("decision_reason")
  previousRequestId String?            @unique @map("previous_request_id") @db.Uuid
  submittedAt       DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  principal       User                       @relation(fields: [principalUserId], references: [id])
  school          School?                    @relation(fields: [schoolId], references: [id])
  previousRequest SchoolVerificationRequest? @relation("VerificationResubmission", fields: [previousRequestId], references: [id])
  nextRequest     SchoolVerificationRequest? @relation("VerificationResubmission")

  /// One pending request per principal at a time.
  @@unique([principalUserId], map: "svr_one_pending_per_principal", where: raw("status = 'pending'"))
  @@index([status, submittedAt])
  @@index([principalUserId])
  @@map("school_verification_requests")
}

/// Company staff (Super Admin, School Verifier). Not school members. Owned by the platform module.
model PlatformStaff {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole
  status    UserStatus   @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("platform_staff")
}

/// Grants a user one role in one school. A user may hold several roles in the same school.
/// RLS: rows of app.school_id; plus read-only access to the user's own rows via app.user_id.
model SchoolMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(invited)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?          @map("created_by") @db.Uuid

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, schoolId, role])
  @@index([schoolId])
  @@map("school_memberships")
}

/// Global permission catalogue. Read-only for the app role.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@map("permissions")
}

/// Default role -> permission mapping (global). Per-school overrides come later.
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         Role
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}
